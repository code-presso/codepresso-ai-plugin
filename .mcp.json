{
  "mcpServers": {
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_API_KEY": "REPLACE_WITH_YOUR_NOTION_KEY"
      }
    },
    "codepresso-notion": {
      "command": "node",
      "args": ["./mcp/notion-server.mjs"]
    },
    "cloud-dev": {
      "command": "node",
      "args": ["./mcp/cloud-dev-server.mjs"]
    }
  }
}
